CONFIG_IDF_TARGET="esp32s3"

# Performance
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Console on the built-in USB-Serial/JTAG (native USB). DOOM does not run
# TinyUSB, so logs/flashing work over the same USB-C cable.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Long WDT — DOOM's main loop is a tight busy loop.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_EN=n

# Flash: CrossPad has 16MB, QIO @ 80MHz.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom partition table (factory app + rofs WAD partition).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: CrossPad has 8MB octal PSRAM @ 80MHz. DOOM's zone + assets live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
